killTrig1 <- Entities.CreateByClassname("trigger_hurt")
killTrig1.__KeyValueFromInt("Solid", 3)
killTrig1.SetAbsOrigin(Vector(1218, 1955, -126))
killTrig1.SetSize(Vector() - Vector(80, 80, 32), Vector(80, 80, 0))
killTrig1.__KeyValueFromString("targetname", "prevent_softlock_kill_trigger")
killTrig1.__KeyValueFromInt("spawnflags", 64)
killTrig1.__KeyValueFromString("damagetype", "32")
killTrig1.__KeyValueFromString("damage", "500")
killTrig1.__KeyValueFromString("damagecap", "500")
EntFireByHandle(killTrig1, "enable", "", 0, null, null)
EntFireByHandle(killTrig1, "addoutput", "damagetype 32", 0, null, null)
EntFireByHandle(killTrig1, "addoutput", "OnStartTouch !activator:silentdissolve", 0, null, null)
EntFireByHandle(killTrig1, "addoutput", "OnStartTouch !activator:sethealth:-9999999", 0.01, null, null)
